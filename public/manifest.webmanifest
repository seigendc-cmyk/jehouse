{
  "name": "PressCraft Book Studio",
  "short_name": "PressCraft",
  "id": "/",
  "description": "An offline-first studio for writing, designing and publishing books.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "theme_color": "#EA580C",
  "background_color": "#EA580C",
  "categories": ["books", "productivity", "education"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Open PressCraft Studio",
      "short_name": "Open Studio",
      "description": "Open the PressCraft book publishing workspace.",
      "url": "/?source=shortcut",
      "icons": [{ "src": "/icons/presscraft-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/presscraft-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/presscraft-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/presscraft-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
