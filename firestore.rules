rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/projects/{projectId} {
      function ownsPath() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if ownsPath() && resource.data.ownerId == userId;
      allow create: if ownsPath()
        && request.resource.data.ownerId == userId
        && request.resource.data.projectId == projectId
        && request.resource.data.remoteRevision == 1;
      allow update: if ownsPath()
        && resource.data.ownerId == userId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.projectId == projectId
        && request.resource.data.remoteRevision == resource.data.remoteRevision + 1;
      allow delete: if ownsPath() && resource.data.ownerId == userId;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
